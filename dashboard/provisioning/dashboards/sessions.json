{
  "uid": "pt-sessions",
  "title": "Sessions",
  "description": "One row per app launch. Abnormal ends (crash, kill, OOM) are highlighted. Click a row to open its timeline.",
  "tags": [
    "playtest-telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "definition": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "build",
        "label": "Build",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select distinct build_version from v_sessions where project_id = '$project' order by 1 desc",
        "definition": "select distinct build_version from v_sessions where project_id = '$project' order by 1 desc",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "options": [],
        "current": {},
        "allValue": null
      }
    ]
  },
  "links": [
    {
      "title": "Playtest Telemetry",
      "type": "dashboards",
      "tags": [
        "playtest-telemetry"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sessions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as sessions from v_sessions where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Abnormal ends",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as abnormal from v_sessions where project_id = '$project' and build_version in (${build:sqlstring}) and end_reason = 'abnormal' and $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg session length",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(avg(duration_s), 0) as avg_duration from v_sessions where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Testers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(distinct coalesce(tester_alias, device_id)) as testers from v_sessions where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Sessions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  started_at as \"Started\", coalesce(tester_alias, '(none)') as \"Tester\", device_model as \"Device\", os as \"OS\",\n  build_version as \"Build\", duration_s as \"Duration\", error_count as \"Errors\",\n  worst_fps_p1_low as \"Worst FPS (1% low)\", peak_memory_mb as \"Peak memory (MB)\",\n  coalesce(end_reason, 'running') as \"End\", session_id\nfrom v_sessions\nwhere project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(started_at)\norder by started_at desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Worst FPS (1% low)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "End"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "abnormal": {
                        "color": "red",
                        "index": 0,
                        "text": "abnormal"
                      },
                      "clean": {
                        "color": "green",
                        "index": 1,
                        "text": "clean"
                      },
                      "running": {
                        "color": "blue",
                        "index": 2,
                        "text": "running"
                      },
                      "unknown": {
                        "color": "orange",
                        "index": 3,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open session timeline",
                    "url": "/d/pt-timeline?var-project=${project}&var-session=${__data.fields.session_id}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tester"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open session timeline",
                    "url": "/d/pt-timeline?var-project=${project}&var-session=${__data.fields.session_id}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    }
  ]
}
