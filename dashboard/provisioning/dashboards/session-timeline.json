{
  "uid": "pt-timeline",
  "title": "Session timeline",
  "description": "Everything that happened in one session in time order: logs, custom events, perf samples and bug reports. Set the time range to cover the session.",
  "tags": [
    "playtest-telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "definition": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select to_char(started_at, 'MM-DD HH24:MI') || ' · ' || coalesce(tester_alias, '?') || ' · ' || device_model || ' · ' || build_version as __text, session_id::text as __value from v_sessions where project_id = '$project' order by started_at desc limit 200",
        "definition": "select to_char(started_at, 'MM-DD HH24:MI') || ' · ' || coalesce(tester_alias, '?') || ' · ' || device_model || ' · ' || build_version as __text, session_id::text as __value from v_sessions where project_id = '$project' order by started_at desc limit 200",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      }
    ]
  },
  "links": [
    {
      "title": "Playtest Telemetry",
      "type": "dashboards",
      "tags": [
        "playtest-telemetry"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Session",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select started_at as \"Started\", coalesce(tester_alias, '(none)') as \"Tester\", device_model as \"Device\", os as \"OS\", platform as \"Platform\", build_version as \"Build\", duration_s as \"Duration\", error_count as \"Errors\", coalesce(end_reason, 'running') as \"End\" from v_sessions where session_id = '$session'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "End"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "abnormal": {
                        "color": "red",
                        "index": 0,
                        "text": "abnormal"
                      },
                      "clean": {
                        "color": "green",
                        "index": 1,
                        "text": "clean"
                      },
                      "running": {
                        "color": "blue",
                        "index": 2,
                        "text": "running"
                      },
                      "unknown": {
                        "color": "orange",
                        "index": 3,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "FPS",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, fps_avg as \"FPS (avg)\", fps_p1_low as \"FPS (1% low)\" from v_session_timeline where session_id = '$session' and kind = 'perf' order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select ts as time, used_mem_mb as \"Used memory (MB)\" from v_session_timeline where session_id = '$session' and kind = 'perf' order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Timeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 16
      },
      "description": "Use the column filters to focus on one kind (log, event, perf, bug_report).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select ts as \"Time\", kind as \"Kind\", coalesce(log_type, '') as \"Level\", title as \"What\", detail as \"Detail\", repeat_count as \"Repeats\", scene as \"Scene\"\nfrom v_session_timeline where session_id = '$session' order by ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "What"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "log": {
                        "color": "orange",
                        "index": 0,
                        "text": "log"
                      },
                      "event": {
                        "color": "blue",
                        "index": 1,
                        "text": "event"
                      },
                      "perf": {
                        "color": "green",
                        "index": 2,
                        "text": "perf"
                      },
                      "bug_report": {
                        "color": "purple",
                        "index": 3,
                        "text": "bug_report"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Exception": {
                        "color": "red",
                        "index": 0,
                        "text": "Exception"
                      },
                      "Error": {
                        "color": "orange",
                        "index": 1,
                        "text": "Error"
                      },
                      "Warning": {
                        "color": "yellow",
                        "index": 2,
                        "text": "Warning"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": false
          }
        ]
      }
    }
  ]
}
