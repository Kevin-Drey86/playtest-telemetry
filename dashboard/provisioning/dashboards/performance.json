{
  "uid": "pt-performance",
  "title": "Performance",
  "description": "Compare builds and devices. FPS 1% low and memory are percentiles over all retained perf samples.",
  "tags": [
    "playtest-telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "definition": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "build",
        "label": "Build",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select distinct build_version from v_sessions where project_id = '$project' order by 1 desc",
        "definition": "select distinct build_version from v_sessions where project_id = '$project' order by 1 desc",
        "refresh": 1,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "options": [],
        "current": {},
        "allValue": null
      }
    ]
  },
  "links": [
    {
      "title": "Playtest Telemetry",
      "type": "dashboards",
      "tags": [
        "playtest-telemetry"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "FPS (1% low) by device and build",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "description": "Higher is better. A drop between builds of the same device is a regression.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select device_model || ' · ' || build_version as \"Device · Build\", round(fps_p1_low_p50::numeric, 1) as \"median 1% low\", round(fps_p1_low_p05::numeric, 1) as \"p5 1% low\", round(fps_avg_p50::numeric, 1) as \"median avg FPS\"\nfrom v_perf_by_device where project_id = '$project' and build_version in (${build:sqlstring}) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Device · Build",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Memory by device and build",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "description": "Lower is better.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select device_model || ' · ' || build_version as \"Device · Build\", round(mem_mb_p50::numeric) as \"median\", round(mem_mb_p95::numeric) as \"p95\", mem_mb_max as \"max\"\nfrom v_perf_by_device where project_id = '$project' and build_version in (${build:sqlstring}) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Device · Build",
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Build-over-build changes (per device)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "description": "Change versus the previous build of the same device (builds sorted by version string). Red = worse.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select device_model as \"Device\", build_version as \"Build\", round(fps_p1_low_p50::numeric, 1) as \"FPS 1% low\",\n  round((fps_p1_low_p50 - lag(fps_p1_low_p50) over w)::numeric, 1) as \"FPS change\",\n  round(mem_mb_p95::numeric) as \"Memory p95 (MB)\", round((mem_mb_p95 - lag(mem_mb_p95) over w)::numeric) as \"Memory change (MB)\",\n  sample_count as \"Samples\"\nfrom v_perf_by_device where project_id = '$project'\nwindow w as (partition by device_model order by build_version)\norder by device_model, build_version"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "FPS change"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory change (MB)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "FPS (1% low) over time, by build",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(client_ts, '1h'), build_version as metric, avg(fps_p1_low) as \"FPS 1% low\"\nfrom v_perf_samples where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(client_ts) group by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Thermal state distribution",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(thermal_state, 'unknown') as metric, count(*) as value\nfrom v_perf_samples where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(client_ts) group by 1 order by 2 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^value$/"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Time spent hot (Serious or worse)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 17,
        "w": 6,
        "h": 8
      },
      "description": "Share of perf samples where the device reported Serious/Severe/Critical thermal state (Android: Severe+, iOS: Serious+).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select device_model || ' · ' || build_version as label,\n  round(100.0 * count(*) filter (where thermal_state in ('Serious', 'Severe', 'Critical', 'Emergency', 'Shutdown')) / count(*), 1) as pct_hot\nfrom v_perf_samples where project_id = '$project' and build_version in (${build:sqlstring}) and $__timeFilter(client_ts) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^pct_hot$/"
        },
        "namePlacement": "left",
        "showUnfilled": true
      }
    }
  ]
}
