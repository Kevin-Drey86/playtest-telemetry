{
  "uid": "pt-issue-detail",
  "title": "Issue detail",
  "description": "Every occurrence of one issue, with the stack trace stored once on the issue. Click a row to open its session.",
  "tags": [
    "playtest-telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "definition": "select project_name as __text, project_id::text as __value from v_sessions group by 1, 2 order by 1",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "fingerprint",
        "label": "Issue",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "select left(message_template, 90) || ' (' || log_type || ')' as __text, fingerprint as __value from v_issues where project_id = '$project' order by last_seen_at desc limit 300",
        "definition": "select left(message_template, 90) || ' (' || log_type || ')' as __text, fingerprint as __value from v_issues where project_id = '$project' order by last_seen_at desc limit 300",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      }
    ]
  },
  "links": [
    {
      "title": "Playtest Telemetry",
      "type": "dashboards",
      "tags": [
        "playtest-telemetry"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Issue",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select message_template as \"Message\", log_type as \"Type\", total_count as \"Total\", device_count as \"Devices\", session_count as \"Sessions\", first_seen_build as \"First build\", last_seen_build as \"Last build\", first_seen_at as \"First seen\", last_seen_at as \"Last seen\"\nfrom v_issues where project_id = '$project' and fingerprint = '$fingerprint'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Exception": {
                        "color": "red",
                        "index": 0,
                        "text": "Exception"
                      },
                      "Error": {
                        "color": "orange",
                        "index": 1,
                        "text": "Error"
                      },
                      "Warning": {
                        "color": "yellow",
                        "index": 2,
                        "text": "Warning"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Stack trace",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "description": "Stored once per issue (first occurrence), not per event.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select regexp_split_to_table(stack_trace, E'\\n') as \"Frame\" from v_issues where project_id = '$project' and fingerprint = '$fingerprint'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Occurrences",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select client_ts as \"Time\", message as \"Message\", repeat_count as \"Repeats\", build_version as \"Build\", device_model as \"Device\", coalesce(tester_alias, '(none)') as \"Tester\", scene as \"Scene\",\n  context::text as \"Context\", breadcrumbs::text as \"Breadcrumbs\", session_id\nfrom v_issue_events where project_id = '$project' and fingerprint = '$fingerprint' order by client_ts desc limit 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 380
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open session timeline",
                    "url": "/d/pt-timeline?var-project=${project}&var-session=${__data.fields.session_id}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    }
  ]
}
