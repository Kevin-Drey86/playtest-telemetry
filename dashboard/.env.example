# Copy to .env (gitignored). Placeholders only: never commit real values.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Supabase > Connect > Session pooler (IPv4). The user is "<role>.<project-ref>".
# The role is dashboard_reader (read-only, views only); set its password with:
#   alter role dashboard_reader password '<strong password>';
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=dashboard_reader.your-project-ref
SUPABASE_DB_PASSWORD=your-dashboard-reader-password
